{
  "name": "ai-print-studio",
  "version": "0.31.41",
  "description": "Lokale Bild-zu-3D-Desktop-App für Apple Silicon",
  "author": "Michael Schellenberger",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json && node scripts/copy-electron-vendor.mjs",
    "test": "vitest run",
    "test:golden": "vitest run electron/golden-relief.test.ts electron/export-validation.test.ts",
    "test:slicers": "vitest run electron/slicer-compatibility.test.ts",
    "lint": "eslint . --max-warnings 0",
    "verify": "npm run lint && npm run test && npm run build",
    "build:depth-worker": "zsh scripts/build-depth-worker.sh",
    "build:dmg-background": "node scripts/build-dmg-background.mjs",
    "smoke:depth-worker": "node scripts/smoke-depth-worker.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "dist": "npm run build && npm run build:depth-worker && npm run build:dmg-background && electron-builder --mac dmg --publish never",
    "revision": "node scripts/revision.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@xmldom/xmldom": "^0.9.10",
    "d3-contour": "^4.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "manifold-3d": "^3.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "three": "^0.172.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "de.michaelschellenberger.aiprintstudio",
    "productName": "AI Print Studio",
    "afterSign": "scripts/after-sign.mjs",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/depth/DepthAnythingV2SmallF16P6.mlmodelc",
        "to": "depth/DepthAnythingV2SmallF16P6.mlmodelc"
      },
      {
        "from": "resources/depth/depth-worker",
        "to": "depth/depth-worker"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "minimumSystemVersion": "13.0.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "AI Print Studio ${version}",
      "background": "build/background.png",
      "iconSize": 92,
      "iconTextSize": 12,
      "window": {
        "width": 640,
        "height": 420
      },
      "contents": [
        {
          "x": 170,
          "y": 245,
          "type": "file"
        },
        {
          "x": 470,
          "y": 245,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
